        <mxCell id="legend" value="Architecture rule: the local edge server is authoritative for sensing, security state, evidence, and siren activation. Cloud loss never disables local protection (FR-13 / RE-02)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1265" y="935" width="600" height="55" as="geometry"/></mxCell>
